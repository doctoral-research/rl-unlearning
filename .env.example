# RL-Unlearning Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Weights & Biases API Key
# Get your key at: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Optional: WandB entity (team or username)
# WANDB_ENTITY=your_team_or_username

# Optional: Default project name
# WANDB_PROJECT=rl-unlearning

# CUDA device selection (default: 0)
# CUDA_VISIBLE_DEVICES=0
